<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>rusttext</AssemblyName>
    <Version>2.8.3</Version>
    <ApplicationIcon>../../assets/rusttext.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishDebugSymbols Condition="'$(Configuration)' == 'Release'">false</PublishDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep short-lived editing allocations from growing the desktop working set on CPUs with large caches. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionSize" Value="1048576" />
    <InternalsVisibleTo Include="RustText.Tests" />
    <AvaloniaResource Include="../../assets/rusttext.ico" Link="Assets/rusttext.ico" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" GeneratePathProperty="true" PrivateAssets="all" />
    <NativePayload Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.3\runtimes\win-x64\native\libHarfBuzzSharp.dll" />
    <NativePayload Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.4\runtimes\win-x64\native\libSkiaSharp.dll" />
    <NativePayload Include="$(NuGetPackageRoot)avalonia.angle.windows.natives\2.1.27548.20260419\runtimes\win-x64\native\av_libglesv2.dll" />
    <EmbeddedResource Include="@(NativePayload)">
      <LogicalName>RustText.Demo.NativePayload.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CreateWinX64NativePayloadHashes" BeforeTargets="AssignTargetPaths"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <GetFileHash Files="@(NativePayload)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_NativePayloadWithHash" />
    </GetFileHash>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)native-payload.sha256" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="@(_NativePayloadWithHash->'%(Filename)%(Extension) %(FileHash)')" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)native-payload.sha256" LogicalName="RustText.Demo.NativePayload.sha256" />
      <FileWrites Include="$(IntermediateOutputPath)native-payload.sha256" />
    </ItemGroup>
  </Target>

  <Target Name="ExcludeEmbeddedNativePayloadFromPublish" AfterTargets="ComputeFilesToPublish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.dll' or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll' or '%(Filename)%(Extension)' == 'av_libglesv2.dll' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
