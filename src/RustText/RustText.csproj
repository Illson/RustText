<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>rusttext</AssemblyName>
    <Version>2.2.3</Version>
    <ApplicationIcon>../../assets/rusttext.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishDebugSymbols Condition="'$(Configuration)' == 'Release'">false</PublishDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep short-lived editing allocations from growing the desktop working set on CPUs with large caches. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionSize" Value="1048576" />
    <InternalsVisibleTo Include="RustText.Tests" />
    <AvaloniaResource Include="../../assets/rusttext.ico" Link="Assets/rusttext.ico" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" GeneratePathProperty="true" PrivateAssets="all" />
    <EmbeddedResource Include="$(NuGetPackageRoot)avalonia.angle.windows.natives\2.1.27548.20260419\runtimes\win-x64\native\av_libglesv2.dll">
      <LogicalName>RustText.Demo.NativePayload.av_libglesv2.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.3\runtimes\win-x64\native\libHarfBuzzSharp.dll">
      <LogicalName>RustText.Demo.NativePayload.libHarfBuzzSharp.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.4\runtimes\win-x64\native\libSkiaSharp.dll">
      <LogicalName>RustText.Demo.NativePayload.libSkiaSharp.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateWinX64NativePayload" BeforeTargets="CoreCompile"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('$(NuGetPackageRoot)avalonia.angle.windows.natives\2.1.27548.20260419\runtimes\win-x64\native\av_libglesv2.dll')"
           Text="The Avalonia ANGLE win-x64 native payload is missing from the NuGet cache." />
    <Error Condition="!Exists('$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.3\runtimes\win-x64\native\libHarfBuzzSharp.dll')"
           Text="The HarfBuzz win-x64 native payload is missing from the NuGet cache." />
    <Error Condition="!Exists('$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.4\runtimes\win-x64\native\libSkiaSharp.dll')"
           Text="The SkiaSharp win-x64 native payload is missing from the NuGet cache." />
  </Target>

  <Target Name="ExcludeEmbeddedNativePayloadFromPublish" AfterTargets="ComputeFilesToPublish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.dll' or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll' or '%(Filename)%(Extension)' == 'av_libglesv2.dll' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
