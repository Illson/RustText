<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RustText.Demo"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="RustText.Demo.MainWindow"
        Icon="avares://rusttext/Assets/rusttext.ico" Title="RustText" Width="1080" Height="700" MinWidth="650" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0"
        Opened="WindowChromeOpened" Closed="WindowChromeClosed"
        Background="{x:Static local:FocusTheme.Editor}" Foreground="{x:Static local:FocusTheme.Text}" FontSize="13">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border x:Name="TitleBar" ZIndex="1" Background="{x:Static local:FocusTheme.TitleBar}" MinHeight="36">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,0,0,0">
                <Border Grid.ColumnSpan="5" Margin="-8,0,0,0" Height="1" VerticalAlignment="Top"
                        IsHitTestVisible="False" Background="{x:Static local:FocusTheme.GlassHighlight}" />
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Menu Classes="focus-menu" VerticalAlignment="Center">
                        <MenuItem x:Name="WorkspaceMenuButton" Padding="2" IsEnabled="False"
                                  AutomationProperties.Name="Рабочие пространства">
                            <MenuItem.Header>
                                <Border x:Name="WorkspaceBadge" Width="27" Height="27" CornerRadius="4" BorderThickness="1.5"
                                        Background="{x:Static local:FocusTheme.AppIconBackground}" BorderBrush="{x:Static local:FocusTheme.AppIconBorder}">
                                    <TextBlock x:Name="WorkspaceBadgeSymbol" Text="›" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{x:Static local:FocusTheme.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </MenuItem.Header>
                        </MenuItem>
                    </Menu>
                    <Button Classes="focus-quiet" Foreground="{x:Static local:FocusTheme.Text}" Padding="5,3"
                            AutomationProperties.Name="Главный экран RustText" Click="HomeClicked">
                        <TextBlock Text="RustText" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
                <Menu Grid.Column="1" x:Name="TopMenu" Classes="focus-menu" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" x:Name="TitleDragArea" Background="Transparent" PointerPressed="WindowDragPressed">
                    <Canvas Width="58" Height="36" Margin="0,0,64,0" HorizontalAlignment="Right"
                            IsHitTestVisible="False">
                      <Path x:Name="TitlePalm" Width="58" Height="36"
                            IsHitTestVisible="False" Fill="{x:Static local:FocusTheme.TitleMotif}"
                          Data="M 14,36 C 17,29 18,20 22,10 L 25,10 C 23,18 21,28 20,36 Z
                                M 23,10 C 26,1 35,0 40,5 C 33,3 28,5 23,10 Z
                                M 24,10 C 34,6 41,12 42,20 C 37,14 31,12 24,12 Z
                                M 23,10 C 18,0 9,1 5,7 C 11,4 18,5 23,10 Z
                                M 22,10 C 12,6 5,13 4,20 C 10,14 16,12 22,12 Z
                                M 23,11 C 21,3 24,0 28,0 L 27,4 C 25,6 25,8 25,11 Z
                                M 24,11 C 28,14 30,20 28,24 C 27,18 25,15 23,12 Z
                                M 34,36 C 37,31 39,25 41,19 L 43,19 C 42,25 40,31 39,36 Z
                                M 42,19 C 43,11 50,10 54,13 C 48,13 45,16 42,19 Z
                                M 42,19 C 50,15 56,19 57,25 C 51,21 46,20 42,20 Z
                                M 42,19 C 38,12 31,13 28,17 C 34,15 38,17 42,19 Z
                                M 42,19 C 35,17 30,22 30,27 C 34,23 38,21 42,20 Z
                                M 42,19 C 45,21 47,26 45,30 C 44,25 43,22 41,20 Z" />
                      <Path x:Name="TitlePalmExtension" Canvas.Top="36" Width="58" Height="34"
                            Fill="{x:Static local:FocusTheme.TitleMotifExtension}"
                            Data="M 14,0 C 12,8 10,19 8,34 L 15,34 C 16,21 18,9 20,0 Z
                                  M 34,0 C 31,7 29,16 27,25 L 33,25 C 35,15 37,7 39,0 Z" />
                    </Canvas>
                </Border>
                <Border Grid.Column="3" x:Name="UpdateNotice" IsVisible="False" Margin="6,0,9,0"
                        VerticalAlignment="Center" CornerRadius="5" BorderThickness="1"
                        Background="{x:Static local:FocusTheme.UpdateSurface}" BorderBrush="{x:Static local:FocusTheme.UpdateBorder}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UpdateNoticeDetails" Classes="focus-quiet" Padding="7,2" Height="24"
                                ToolTip.Tip="Что нового и скачать обновление" Click="UpdateNoticeDetailsClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Path Width="12" Height="12" Data="M 6,1 L 6,8 M 2.5,4.5 L 6,8 L 9.5,4.5 M 2,11 L 10,11"
                                      VerticalAlignment="Center" Stroke="{x:Static local:FocusTheme.Warning}" StrokeThickness="1.35" />
                                <TextBlock x:Name="UpdateNoticeText" MaxWidth="123" TextTrimming="CharacterEllipsis"
                                           Foreground="{x:Static local:FocusTheme.UpdateText}" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UpdateNoticeDismiss" Classes="focus-quiet" Width="24" Height="24" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Foreground="{x:Static local:FocusTheme.UpdateText}" FontSize="16" Content="×"
                                AutomationProperties.Name="Закрыть уведомление об обновлении" Click="UpdateNoticeDismissClicked" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="CaptionMinimize" Classes="focus-caption" AutomationProperties.Name="Свернуть" Click="MinimizeWindowClicked">
                        <Path Width="12" Height="12" Data="M 1,8 L 11,8" Stroke="{x:Static local:FocusTheme.Text}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="CaptionMaximize" Classes="focus-caption" AutomationProperties.Name="Развернуть"
                            chrome:WindowDecorationProperties.ElementRole="MaximizeButton" Click="MaximizeWindowClicked">
                        <Grid Width="12" Height="12">
                            <Path x:Name="MaximizeGlyph" Data="M 1,1 L 11,1 11,11 1,11 Z" Stroke="{x:Static local:FocusTheme.Text}" StrokeThickness="1.25" />
                            <Path x:Name="RestoreGlyph" IsVisible="False" Data="M 4,1 L 11,1 11,8 M 1,4 L 8,4 8,11 1,11 Z"
                                  Stroke="{x:Static local:FocusTheme.Text}" StrokeThickness="1.25" />
                        </Grid>
                    </Button>
                    <Button x:Name="CaptionClose" Classes="focus-caption focus-caption-close" AutomationProperties.Name="Закрыть окно" Click="CloseWindowClicked">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{x:Static local:FocusTheme.Text}"
                              StrokeThickness="1.5" StrokeLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" x:Name="WorkspaceHost"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentControl Grid.Row="2" x:Name="PanelHost" IsVisible="False"
                        HorizontalContentAlignment="Stretch" />
        <Border Grid.Row="3" x:Name="StatusBar" Padding="12,3" MinHeight="26" BorderBrush="{x:Static local:FocusTheme.StatusBorder}"
                BorderThickness="0,1,0,0" Background="{x:Static local:FocusTheme.StatusBar}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" FontSize="12"
                           VerticalAlignment="Center" Foreground="{x:Static local:FocusTheme.Muted}" />
                <TextBlock Grid.Column="1" x:Name="FormatText" FontSize="12"
                           VerticalAlignment="Center" Foreground="{x:Static local:FocusTheme.Muted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
