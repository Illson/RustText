<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RustText.Demo"
        x:Class="RustText.Demo.MainWindow"
        Icon="avares://rusttext/Assets/rusttext.ico" Title="RustText" Width="1080" Height="700" MinWidth="650" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        Background="{x:Static local:FocusTheme.Editor}" Foreground="{x:Static local:FocusTheme.Text}" FontSize="13">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Background="{x:Static local:FocusTheme.Chrome}" BorderBrush="{x:Static local:FocusTheme.Border}"
                BorderThickness="0,0,0,1" MinHeight="36">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,0,0,0">
                <Button Classes="focus-quiet" Foreground="{x:Static local:FocusTheme.Text}" Padding="5,3"
                        AutomationProperties.Name="Главный экран RustText" Click="HomeClicked">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="22" Height="21" CornerRadius="5" Background="{x:Static local:FocusTheme.UpdateIconSurface}" BorderBrush="{x:Static local:FocusTheme.UpdateBorder}" BorderThickness="1">
                            <TextBlock Text="›_" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{x:Static local:FocusTheme.Warning}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="RustText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Menu Grid.Column="1" x:Name="TopMenu" Classes="focus-menu" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="Transparent" PointerPressed="WindowDragPressed" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="CaptionMinimize" Classes="focus-caption" AutomationProperties.Name="Свернуть" Click="MinimizeWindowClicked">
                        <Path Width="12" Height="12" Data="M 1,8 L 11,8" Stroke="{x:Static local:FocusTheme.Text}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="CaptionMaximize" Classes="focus-caption" AutomationProperties.Name="Развернуть" Click="MaximizeWindowClicked">
                        <Grid Width="12" Height="12">
                            <Path x:Name="MaximizeGlyph" Data="M 1,1 L 11,1 11,11 1,11 Z" Stroke="{x:Static local:FocusTheme.Text}" StrokeThickness="1.25" />
                            <Path x:Name="RestoreGlyph" IsVisible="False" Data="M 4,1 L 11,1 11,8 M 1,4 L 8,4 8,11 1,11 Z"
                                  Stroke="{x:Static local:FocusTheme.Text}" StrokeThickness="1.25" />
                        </Grid>
                    </Button>
                    <Button x:Name="CaptionClose" Classes="focus-caption focus-caption-close" AutomationProperties.Name="Закрыть окно" Click="CloseWindowClicked">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{x:Static local:FocusTheme.Text}"
                              StrokeThickness="1.5" StrokeLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" x:Name="UpdateNotice" IsVisible="False"
                Background="{x:Static local:FocusTheme.UpdateSurface}" BorderBrush="{x:Static local:FocusTheme.UpdateBorder}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="5" Background="{x:Static local:FocusTheme.UpdateIconSurface}">
                        <Path Width="12" Height="12" Data="M 6,1 L 6,8 M 2.5,4.5 L 6,8 L 9.5,4.5 M 2,11 L 10,11"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{x:Static local:FocusTheme.Warning}" StrokeThickness="1.35" />
                    </Border>
                    <TextBlock x:Name="UpdateNoticeText" Foreground="{x:Static local:FocusTheme.UpdateText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="UpdateNoticeDetails" Classes="focus-quiet" Padding="9,3"
                        Background="{x:Static local:FocusTheme.UpdateIconSurface}" Foreground="{x:Static local:FocusTheme.Warning}"
                        Content="Подробнее" Click="UpdateNoticeDetailsClicked" />
                <Button Grid.Column="2" x:Name="UpdateNoticeDismiss" Classes="focus-quiet" Padding="6,2"
                        Foreground="{x:Static local:FocusTheme.UpdateText}" FontSize="17" Content="×"
                        AutomationProperties.Name="Закрыть уведомление об обновлении" Click="UpdateNoticeDismissClicked" />
            </Grid>
        </Border>
        <ContentControl Grid.Row="2" x:Name="WorkspaceHost"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentControl Grid.Row="3" x:Name="PanelHost" IsVisible="False"
                        HorizontalContentAlignment="Stretch" />
        <Border Grid.Row="4" Padding="12,3" MinHeight="26" BorderBrush="{x:Static local:FocusTheme.Border}"
                BorderThickness="0,1,0,0" Background="{x:Static local:FocusTheme.Deep}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" FontSize="12"
                           VerticalAlignment="Center" Foreground="{x:Static local:FocusTheme.Muted}" />
                <TextBlock Grid.Column="1" x:Name="FormatText" FontSize="12"
                           VerticalAlignment="Center" Foreground="{x:Static local:FocusTheme.Muted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
