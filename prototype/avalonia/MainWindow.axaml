<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RustText.Demo.MainWindow"
        Icon="avares://rusttext/Assets/rusttext.ico" Title="RustText" Width="1080" Height="700" MinWidth="650" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#131B23" Foreground="#E9F0F6">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border BorderBrush="#31404D" BorderThickness="0,0,0,1" Background="#17212A">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="RustText" Background="Transparent"
                        FontWeight="SemiBold" Padding="16,8" Click="HomeClicked" />
                <Menu x:Name="TopMenu" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ContentControl Grid.Row="1" x:Name="WorkspaceHost"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentControl Grid.Row="2" x:Name="PanelHost" IsVisible="False"
                        HorizontalContentAlignment="Stretch" />
        <Border Grid.Row="3" Padding="12,5" BorderBrush="#31404D" BorderThickness="0,1,0,0"
                Background="#17212A">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" Foreground="#C0CEDA" />
                <TextBlock Grid.Column="1" x:Name="FormatText" Foreground="#C0CEDA" />
            </Grid>
        </Border>
    </Grid>
</Window>
